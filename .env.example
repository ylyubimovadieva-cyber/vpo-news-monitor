# Приклад змінних оточення для локального запуску.
# Скопіюйте у .env лише на своєму комп'ютері (файл .env не потрапляє в git)
# або задайте їх у PowerShell: $env:ANTHROPIC_API_KEY = "..."
# У GitHub ці значення вносяться в Settings -> Secrets and variables -> Actions.

ANTHROPIC_API_KEY=
TELEGRAM_APPROVAL_BOT_TOKEN=
# Якщо публікує той самий бот, цю змінну можна не задавати
TELEGRAM_PUBLISH_BOT_TOKEN=
# Необов'язково: перекриває telegram.coordinator_chat_id з config.yaml
TELEGRAM_COORDINATOR_CHAT_ID=
# Тестова група для DRY_RUN; якщо порожньо, "публікації" лише пишуться в лог
TELEGRAM_TEST_GROUP_CHAT_ID=
FACEBOOK_PAGE_TOKEN=
# Токен LinkedIn з дозволом w_organization_social (діє 60 днів)
LINKEDIN_ACCESS_TOKEN=

# Безпечні значення за замовчуванням: нічого не йде в бойові канали
DRY_RUN=true
LIVE_CONFIRMED=false
# Токен для ЧИТАННЯ чужих сторінок Facebook (Page Public Content Access); без нього джерела type: facebook пропускаються
FACEBOOK_READ_TOKEN=
